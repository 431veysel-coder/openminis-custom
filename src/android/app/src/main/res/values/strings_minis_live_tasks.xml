<!-- [MINIS-OZEL] Live tasks panel + background permission gates.
     Kept out of strings.xml so an upstream merge of that file cannot conflict. -->
<resources>
    <!-- [MINIS-OZEL] Background gates -->
    <string name="gate_section_ok">Background permissions — all clear</string>
    <string name="gate_section_blocked">Background permissions — %1$d blocked</string>
    <string name="gate_section_footer">These are the OS gates that decide whether a task survives with the screen off. Tap a blocked row to open the setting that fixes it.</string>
    <string name="gate_doze_title">Battery optimisation</string>
    <string name="gate_doze_detail">Off: the system freezes the app in Doze and a background turn stops mid-way.</string>
    <string name="gate_bg_restricted_title">Background restriction</string>
    <string name="gate_bg_restricted_detail">Off: the app may not start work while in the background, even if it is exempt from Doze.</string>
    <string name="gate_exact_alarm_title">Exact alarms</string>
    <string name="gate_exact_alarm_detail">Off: scheduled tasks still fire, but the system may delay them by up to an hour.</string>
    <string name="gate_notifications_title">Notifications</string>
    <string name="gate_notifications_detail">Off: a finished background task has no way to tell you it is done.</string>
    <string name="gate_data_saver_title">Data saver</string>
    <string name="gate_data_saver_detail">On: background network is capped, which shows up as a provider timeout, not a permission error.</string>
    <!-- [MINIS-OZEL] Live tasks panel -->
    <string name="live_tasks_title">Live Tasks</string>
    <string name="live_tasks_section_memory">Memory</string>
    <string name="live_tasks_memory_footer">Java heap is the 512 MB ceiling the app runs under; RSS is what the process really occupies, and VmSize counts address-space reservations (large is normal).</string>
    <string name="live_tasks_heap">Heap %1$d / %2$d MB (%3$d%%)</string>
    <string name="live_tasks_rss">RSS %1$d MB · peak %2$d MB · virtual %3$d MB</string>
    <string name="live_tasks_section_running">Running now (%1$d)</string>
    <string name="live_tasks_running_footer">A turn that is queued is waiting for one of the concurrent agent slots. Tap a row to open the chat.</string>
    <string name="live_tasks_idle">Nothing is running.</string>
    <string name="live_tasks_status_running">Running</string>
    <string name="live_tasks_status_queued">Queued — waiting for a slot</string>
    <string name="live_tasks_status_pending">Pending</string>
    <string name="live_tasks_status_done">Done</string>
    <string name="live_tasks_status_failed">Failed</string>
    <string name="live_tasks_status_cancelled">Cancelled</string>
    <string name="live_tasks_status_timeout">Timed out</string>
    <string name="live_tasks_section_jobs">Delegated runs (%1$d)</string>
    <string name="live_tasks_jobs_footer">Sub agents and background helpers. Cancelling one stops that run only; the chat it belongs to keeps going.</string>
    <string name="live_tasks_no_jobs">No delegated runs in flight.</string>
    <string name="live_tasks_cancel">Cancel</string>
    <string name="live_tasks_section_scheduled">Scheduled (%1$d)</string>
    <string name="live_tasks_scheduled_footer">Registered with the system alarm clock, so these fire even when the app is closed.</string>
